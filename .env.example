# Copia este archivo como .env.local y llena los valores (Supabase > Project Settings > API Keys).
# Son obligatorios: sin ellos el panel muestra «Falta conectar Supabase».
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Número de WhatsApp de reservas: código de país + número (ej. 584121234567)
VITE_WHATSAPP=
